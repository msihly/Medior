{
  "name": "medior",
  "description": "The Organizer",
  "author": "msihly",
  "version": "2.13.0",
  "private": true,
  "homepage": "./",
  "main": "extraResources/medior/server/main.js",
  "icon": "public/favicon.ico",
  "scripts": {
    ".exe": "start \"\" dist/win-unpacked/Medior.exe",
    "build": "pnpm run pre-build && vite build",
    "check": "pnpm run ts-check && pnpm run lint && pnpm run prettier",
    "check-fix": "pnpm run lint-fix && pnpm run prettier-fix",
    "copy-files": "copyfiles extraResources/**/* build",
    "dev": "SET BUILD_DEV=true&& pnpm run pre-build && tsx scripts/dev.mts",
    "dist": "rimraf build dist extraResources && pnpm run build && pnpm run electron-build && copyfiles config.json dist/win-unpacked",
    "electron-build": "electron-builder build --dir --win --publish never",
    "gen": "tsx medior/generator/generator.ts",
    "hmr": "SET HMR=true&& SET BROWSER=none&& pnpm run pre-build && tsx scripts/dev.mts hmr",
    "kill-ports": "kill-port 3333 3334 3335",
    "lint": "eslint medior/**/*{.ts,.tsx}",
    "lint-fix": "pnpm run lint --fix",
    "postinstall": "electron-builder install-app-deps",
    "pre-build": "pnpm run gen && pnpm run ts-compile-server && pnpm run copy-files",
    "prettier": "prettier --check medior scripts --config ./.prettierrc --ignore-path ./.prettierignore",
    "prettier-fix": "pnpm run prettier --write",
    "trabecula": "tsx scripts/update-trabecula.ts",
    "ts-check": "tsc --noEmit",
    "ts-compile-server": "tsx esbuild.server.ts"
  },
  "dependencies": {
    "@electron/remote": "^2.1.4",
    "@huggingface/transformers": "4.3.2",
    "@lancedb/lancedb": "^0.41.0",
    "@panzoom/panzoom": "^4.6.2",
    "apache-arrow": "^21.2.0",
    "bson": "^7.3.2",
    "check-disk-space": "^4.0.0",
    "color": "^5.0.3",
    "es-toolkit": "^1.53.1",
    "fastest-levenshtein": "^1.0.16",
    "kill-port": "^2.0.1",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^9.11.4",
    "onnxruntime-node": "1.30.0",
    "sharp": "^0.35.5",
    "sharp-bmp": "^0.1.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "trabecula": "github:msihly/trabecula#ae79d0dc8d80040d763726837bfdacc4000e8154",
    "wavesurfer.js": "^8.0.5"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/kill-port": "^2.0.1",
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "chalk": "^6.0.1",
    "copyfiles": "^2.4.1",
    "electron": "45.2.1",
    "electron-builder": "^26.18.1",
    "eslint": "10.14.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.x",
    "vite": "8.3.5",
    "vite-plugin-electron-renderer": "1.0.0"
  },
  "build": {
    "appId": "com.msihly.medior",
    "asarUnpack": [
      "**/node_modules/@img/**/*",
      "**/node_modules/sharp/**/*"
    ],
    "executableName": "Medior",
    "extends": null,
    "extraMetadata": {
      "main": "build/extraResources/medior/server/main.js"
    },
    "extraResources": [
      {
        "from": "./extraResources/",
        "to": "extraResources/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "build/**/*",
      "node_modules/**/*"
    ],
    "productName": "Medior",
    "win": {
      "artifactName": "Medior.exe",
      "icon": "build/app-icon.ico",
      "target": "portable"
    }
  }
}
